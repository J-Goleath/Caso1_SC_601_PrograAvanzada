@using Caso1.Models.Entities;
@model IEnumerable<Estado>

@{
    ViewBag.Title = "Estados Registrados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    @if (TempData["Exito"] != null)
    {
        <div id="mensajeExito" class="alert alert-success fade show">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="mensajeError" class="alert alert-danger fade show">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Estados Registrados
        </div>
        <div class="card-body">
            @Html.ActionLink(
                     "Registrar nuevo Estado",
                     "Create",
                     null,
                     new { @class = "btn btn-primary mb-3" })

            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripcion</th>
                        <th>Orden</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var estado in Model)
                    {
                        <tr>
                            <td>@estado.EstadoId</td>
                            <td>@estado.Nombre</td>
                            <td>@estado.Descripcion</td>
                            <td>@estado.Orden</td>
                            <td>@(estado.Activo ? "Si" : "No")</td>
                            <td>
                                @Html.ActionLink(
                                         "Detalles",
                                         "Details",
                                         new { id = estado.EstadoId },
                                         new { @class = "btn btn-info btn-sm" })

                                @Html.ActionLink(
                                         "Editar",
                                         "Edit",
                                         new { id = estado.EstadoId },
                                         new { @class = "btn btn-warning btn-sm" })

                                @using (Html.BeginForm("Delete", "Estados", new { id = estado.EstadoId }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('¿Esta seguro de eliminar este estado?')">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function desplegarMensaje(nombreMensaje) {
        const mensaje = document.getElementById(nombreMensaje);
        if (mensaje) {
            mensaje.style.transition = "opacity 1.5s";
            setTimeout(function () {
                mensaje.style.opacity = "0";
                mensaje.remove();
            }, 3000);
        }
    }
    desplegarMensaje("mensajeExito");
    desplegarMensaje("mensajeError");
</script>
