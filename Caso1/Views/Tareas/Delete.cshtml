@model Caso1.Models.Entities.Tarea

@{
    ViewBag.Title = "Eliminar Tarea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Eliminar Tarea
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                ¿Está seguro de que desea eliminar la tarea <strong>@Model.Titulo</strong>?
            </div>

            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Titulo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Titulo)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Detalle)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Detalle)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaHora)</dt>
                <dd class="col-sm-9">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
                <dd class="col-sm-9">@Model.Estado</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Tareas", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                @Html.ActionLink("No, cancelar", "Index", null, new { @class = "btn btn-secondary" })
            }
        </div>
    </div>
</div>
