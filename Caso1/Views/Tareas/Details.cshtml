@using Caso1.Entities;
@model Caso1.Entities.Tarea

@{
    ViewBag.Title = "Detalles de la Tarea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Detalles de la Tarea
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Id)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Id)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Titulo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Titulo)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Detalle)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Detalle)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaHora)</dt>
                <dd class="col-sm-9">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
                <dd class="col-sm-9">
                    @{
                        string badge = "secondary";
                        string label = Model.Estado.ToString();
                        switch (Model.Estado)
                        {
                            case EstadoTarea.Pendiente: badge = "warning"; label = "Pendiente"; break;
                            case EstadoTarea.EnProceso: badge = "info"; label = "En Proceso"; break;
                            case EstadoTarea.Completada: badge = "success"; label = "Completada"; break;
                            case EstadoTarea.Cancelada: badge = "danger"; label = "Cancelada"; break;
                        }
                    }
                    <span class="badge badge-@badge">@label</span>
                </dd>
            </dl>

            <div class="form-group mt-3">
                @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
                @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
</div>
