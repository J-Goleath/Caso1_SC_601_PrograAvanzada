@using Caso1.Entities;
@model Caso1.Entities.Tarea

@{
    ViewBag.Title = "Editar Tarea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Editar Tarea
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.Borrado)

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Titulo, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Detalle, new { @class = "font-weight-bold" })
                            @Html.TextAreaFor(model => model.Detalle, new { @class = "form-control", rows = 4 })
                            @Html.ValidationMessageFor(model => model.Detalle, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FechaHora, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(model => model.FechaHora, new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(model => model.FechaHora, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Estado, new { @class = "font-weight-bold" })
                            @Html.DropDownListFor(model => model.Estado, ViewBag.Estados as SelectList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Actualizar</button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
