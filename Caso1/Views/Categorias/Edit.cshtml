@model Caso1.Models.DTOs.EditarCategoriaDto

@{
    ViewBag.Title = "Editar Categoria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Editar Categoria
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "Categorias", FormMethod.Post, new { id = "formEditarCategoria" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Nombre, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Descripcion, new { @class = "font-weight-bold" })
                            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = 4 })
                            @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">
                        Actualizar
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(function () {

            $("#formEditarCategoria").submit(function (event) {

                $(".jquery-error").remove();

                var tieneErrores = false;

                var nombre = $("#Nombre").val().trim();
                var descripcion = $("#Descripcion").val().trim();

                if (nombre.length < 3) {
                    mostrarError("#Nombre", "El nombre debe tener al menos 3 caracteres.");
                    tieneErrores = true;
                }

                if (descripcion.length < 5) {
                    mostrarError("#Descripcion", "La descripción debe tener al menos 5 caracteres.");
                    tieneErrores = true;
                }

                if (tieneErrores) {
                    event.preventDefault();
                }

            });

            function mostrarError(selector, mensaje) {
                $(selector).after(
                    "<span class='text-danger jquery-error d-block mt-1'>" +
                    mensaje +
                    "</span>"
                );
            }

        });

    </script>
}
