@model Caso1.Entities.Tarea
@{
    ViewBag.Title = "Nueva Tarea";
}

<div class="container mt-4">
    <h2>Nueva Tarea</h2>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Titulo, new { @class = "control-label col-md-2" })
                <div class="col-md-8">
                    @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Detalle, new { @class = "control-label col-md-2" })
                <div class="col-md-8">
                    @Html.TextAreaFor(m => m.Detalle, 4, 0, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Detalle, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.FechaHora, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(m => m.FechaHora, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                    @Html.ValidationMessageFor(m => m.FechaHora, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Estado, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.DropDownList("Estado", (SelectList)ViewBag.Estados, "-- Seleccione --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-8">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
                </div>
            </div>
        </div>
    }
</div>
