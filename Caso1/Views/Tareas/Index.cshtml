@using Caso1.Entities;
@model IEnumerable<Tarea>

@{
    ViewBag.Title = "Tareas Registradas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    @if (TempData["Exito"] != null)
    {
        <div id="mensajeExito" class="alert alert-success fade show">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="mensajeError" class="alert alert-danger fade show">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Tareas Registradas
        </div>
        <div class="card-body">
            @Html.ActionLink(
                     "Registrar nueva Tarea",
                     "Create",
                     null,
                     new { @class = "btn btn-primary mb-3" })

            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titulo</th>
                        <th>Fecha y Hora</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tarea in Model.Where(t => !t.Borrado))
                    {
                        <tr>
                            <td>@tarea.Id</td>
                            <td>@tarea.Titulo</td>
                            <td>@tarea.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    string badge = "secondary";
                                    string label = tarea.Estado.ToString();
                                    switch (tarea.Estado)
                                    {
                                        case EstadoTarea.Pendiente: badge = "warning"; label = "Pendiente"; break;
                                        case EstadoTarea.EnProceso: badge = "info"; label = "En Proceso"; break;
                                        case EstadoTarea.Completada: badge = "success"; label = "Completada"; break;
                                        case EstadoTarea.Cancelada: badge = "danger"; label = "Cancelada"; break;
                                    }
                                }
                                <span class="badge badge-@badge">@label</span>
                            </td>
                            <td>
                                @Html.ActionLink(
                                         "Detalles",
                                         "Details",
                                         new { id = tarea.Id },
                                         new { @class = "btn btn-info btn-sm" })

                                @Html.ActionLink(
                                         "Editar",
                                         "Edit",
                                         new { id = tarea.Id },
                                         new { @class = "btn btn-warning btn-sm" })

                                @Html.ActionLink(
                                         "Eliminar",
                                         "Delete",
                                         new { id = tarea.Id },
                                         new { @class = "btn btn-danger btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function desplegarMensaje(nombreMensaje) {
        const mensaje = document.getElementById(nombreMensaje);
        if (mensaje) {
            mensaje.style.transition = "opacity 1.5s";
            setTimeout(function () {
                mensaje.style.opacity = "0";
                mensaje.remove();
            }, 3000);
        }
    }
    desplegarMensaje("mensajeExito");
    desplegarMensaje("mensajeError");
</script>
