@model Caso1.Models.DTOs.CrearEstadoDto

@{
    ViewBag.Title = "Registrar Estado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Registrar Nuevo Estado
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "Estados", FormMethod.Post, new { id = "formCrearEstado" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Nombre, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", placeholder = "Ej: En Revision" })
                            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Descripcion, new { @class = "font-weight-bold" })
                            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = 4, placeholder = "Descripcion del estado" })
                            @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Orden, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(model => model.Orden, new { @class = "form-control", type = "number", min = "1" })
                            @Html.ValidationMessageFor(model => model.Orden, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            $("#formCrearEstado").submit(function (event) {

                $(".jquery-error").remove();

                var tieneErrores = false;

                var nombre = $("#Nombre").val().trim();
                var orden = $("#Orden").val();

                if (nombre.length < 2) {
                    mostrarError("#Nombre", "El nombre debe tener al menos 2 caracteres.");
                    tieneErrores = true;
                }

                if (orden === "" || orden < 1) {
                    mostrarError("#Orden", "El orden debe ser un número mayor a 0.");
                    tieneErrores = true;
                }

                if (tieneErrores) {
                    event.preventDefault();
                }

            });

            function mostrarError(selector, mensaje) {
                $(selector).after(
                    "<span class='text-danger jquery-error d-block mt-1'>" +
                    mensaje +
                    "</span>"
                );
            }

        });
    </script>
}
