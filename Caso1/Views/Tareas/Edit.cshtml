@model Caso1.Models.DTOs.EditarTareaDto

@{
    ViewBag.Title = "Editar Tarea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Editar Tarea
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "Tareas", FormMethod.Post, new { id = "formEditarTarea" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Titulo, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Detalle, new { @class = "font-weight-bold" })
                            @Html.TextAreaFor(model => model.Detalle, new { @class = "form-control", rows = 4 })
                            @Html.ValidationMessageFor(model => model.Detalle, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Estado, new { @class = "font-weight-bold" })

                            @Html.DropDownListFor(
                                model => model.Estado,
                                new SelectList(
                                    new[]
                                    {
                                        "Pendiente",
                                        "EnProceso",
                                        "Completada",
                                        "Cancelada"
                                    },
                                    Model.Estado),
                                "Seleccione un estado",
                                new { @class = "form-control" })

                            @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Actualizar</button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(function () {

            $("#formEditarTarea").submit(function (event) {

                $(".jquery-error").remove();

                var tieneErrores = false;

                var titulo = $("#Titulo").val().trim();
                var detalle = $("#Detalle").val().trim();
                var estado = $("#Estado").val();

                if (titulo.length < 3) {
                    mostrarError("#Titulo");
                    tieneErrores = true;
                }

                if (detalle.length < 5) {
                    mostrarError("#Detalle");
                    tieneErrores = true;
                }

                if (!estado) {
                    mostrarError("#Estado");
                    tieneErrores = true;
                }

                if (tieneErrores) {
                    event.preventDefault();
                }

            });

            function mostrarError(selector, mensaje) {
                $(selector).after(
                    "<span class='text-danger jquery-error d-block mt-1'>" +
                    mensaje +
                    "</span>"
                );
            }

        });

    </script>
}
