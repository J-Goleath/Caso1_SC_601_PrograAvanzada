@model Caso1.Entities.Tarea
@{
    ViewBag.Title = "Eliminar Tarea";
}

<div class="container mt-4">
    <h2>Eliminar Tarea</h2>
    <hr />

    <div class="alert alert-warning">
        <strong>Esta seguro de que desea eliminar esta tarea?</strong>
    </div>

    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(m => m.Titulo)</dt>
        <dd>@Html.DisplayFor(m => m.Titulo)</dd>

        <dt>@Html.DisplayNameFor(m => m.Detalle)</dt>
        <dd>@Html.DisplayFor(m => m.Detalle)</dd>

        <dt>@Html.DisplayNameFor(m => m.FechaHora)</dt>
        <dd>@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt>@Html.DisplayNameFor(m => m.Estado)</dt>
        <dd>@Model.Estado</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="mt-3">
            <button type="submit" class="btn btn-danger">Si, eliminar</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>
